{
  "name": "referentiel-applications",
  "type": "module",
  "version": "1.87.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "format": "prettier . --write",
    "lint": "eslint .",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "test:e2e": "pnpm --dir e2e test:e2e",
    "test:e2e:ui": "pnpm --dir e2e test:e2e:ui",
    "test:e2e:list": "pnpm --dir e2e test:e2e:list",
    "gen": "docker compose exec backend pnpm gen && docker compose exec client pnpm gen"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "3.6.2",
    "typescript-eslint": "^8.57.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
