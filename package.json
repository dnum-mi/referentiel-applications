{
  "name": "referentiel-applications",
  "type": "module",
  "version": "1.60.0",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "format": "prettier . --write",
    "lint": "eslint .",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "gen": "docker compose exec backend pnpm gen && docker compose exec client pnpm gen"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "prettier": "3.6.2",
    "typescript-eslint": "^8.39.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
