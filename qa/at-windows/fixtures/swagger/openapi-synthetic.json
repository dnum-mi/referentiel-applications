  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "OAuth2 authentication using OIDC",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://oidc.example.invalid/auth",
            "tokenUrl": "https://oidc.example.invalid/token",
            "refreshUrl": "https://oidc.example.invalid/token",
            "scopes": {
              "openid": "OpenID scope",
              "profile": "Profile scope"
            }
          }
        }
      },
      "api_key": {
        "type": "apiKey",
        "name": "x-refapp-token",
        "in": "header",
        "description": "Token authentication"
      }
    },
    "schemas": {
      "ApplicationFictive": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant synthétique"
          },
          "label": {
            "type": "string",
            "description": "Libellé fictif"
          }
        }
      }
    }
  },
  "security": [
    {
      "oauth2": []
    },
    {
      "api_key": []
    }
  ],
  "paths": {
    "/applications/{id}": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Lire une application fictive",
        "operationId": "findSyntheticApplication",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifiant de l’application fictive"
          },
          {
            "name": "detail",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Lecture détaillée fictive"
          }
        ],
        "responses": {
          "200": {
            "description": "Application fictive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationFictive"
                },
                "example": {
                  "id": "application-fictive-001",
                  "label": "Application fictive de démonstration"
                }
              }
            }
          },
          "404": {
            "description": "Application fictive absente"
          }
        }
      }
    },
    "/applications": {
      "post": {
        "tags": [
          "Applications"
        ],
        "summary": "Description d’une création fictive — ne pas exécuter",
        "operationId": "describeSyntheticCreation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationFictive"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Réponse fictive, aucune exécution autorisée"
          }
        }
      }
    }
  }
}