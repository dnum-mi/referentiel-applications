{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": ["@nestjs/swagger"],
    "assets": [
      {
        "include": "sbom/schemas/**/*.json",
        "outDir": "dist/src"
      },
      {
        "include": "email/templates/**/*",
        "outDir": "dist/src"
      }
    ]
  }
}
