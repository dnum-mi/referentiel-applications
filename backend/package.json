{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "cmd": "ts-node src/cmd/index.ts",
    "gen": "pnpm db:generate",
    "db:generate": "prisma generate",
    "db:generate:client": "prisma generate --generator client",
    "db:reset": "prisma migrate reset",
    "db:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "build": "nest build",
    "type-check": "tsc --noEmit --incremental false",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "prisma migrate deploy && node dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "db:seed": "prisma db seed",
    "db:seed:qa": "ts-node -r tsconfig-paths/register prisma/seed-qa.ts",
    "migrate:hosting": "ts-node src/scripts/migrate-hostings.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "commander": "^14.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "ecoindex": "^1.0.7",
    "exceljs": "^4.4.0",
    "helmet": "^7.2.0",
    "html-to-text": "^10.0.1",
    "jose": "^5.10.0",
    "lodash": "4.18.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "pptxgenjs": "^4.0.1",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "undici": "^7.30.0",
    "uuid": "11.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/express": "^4.17.25",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.0",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.8",
    "@vue/tsconfig": "^0.7.0",
    "chokidar": "^5.0.0",
    "jest": "^30.5.2",
    "jszip": "^3.10.1",
    "prisma-markdown": "3.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "swagger-themes": "^1.4.3",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".*\\.*spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!dist/**"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "text",
      "cobertura",
      "lcov"
    ],
    "testEnvironment": "node",
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "modulePaths": [
      "<rootDir>"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "maxWorkers": 2,
    "testTimeout": 30000,
    "globalSetup": "<rootDir>/tests/global-setup.ts",
    "globalTeardown": "<rootDir>/tests/global-teardown.ts",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!\\.pnpm|@faker-js)",
      "node_modules/\\.pnpm/(?!@faker-js\\+faker@)"
    ]
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  }
}
