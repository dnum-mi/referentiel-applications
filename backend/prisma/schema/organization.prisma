/// Unité organisationnelle (département, service, etc.).
/// Forme une structure arborescente hiérarchique.
///
/// @namespace Organizations
model Organization {
  /// Identifiant unique
  id                 String            @id @default(uuid())
  /// Chemin complet dans la hiérarchie (ex: "/MI/DNUM/SG")
  path               String
  /// URL du site web pour cette organisation
  url                String?
  /// Acronyme ou nom court
  sigle              String?
  /// Description complète de l'organisation
  description        String?
  parentId           String?
  /// Organisation parente dans la hiérarchie
  parent             Organization?     @relation("OrganizationParent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Organisations enfants
  children           Organization[]    @relation("OrganizationParent")
  /// Utilisateurs appartenant à cette organisation
  users              User[]
  /// Acteurs associés à cette organisation
  actors             Actor[]
  /// Identifiant de la direction metier MOA de l'organisation
  businessDivisionId String?
  /// Direction metier MOA de l'organisation
  businessDivision   BusinessDivision? @relation(fields: [businessDivisionId], references: [id], onDelete: SetNull)
}
