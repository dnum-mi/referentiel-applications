/// Stocke les résultats des analyses Éco-index d'une application.
///
/// @namespace EcoIndex
model ecoEnergy {
  /// Identifiant unique du score Éco-index
  id            String      @id @default(uuid())

  /// L'application analysée
 application    Application @relation("ApplicationToEcoEnergy", fields: [applicationId], references: [id], onDelete: Cascade)
  /// Identifiant de l'application analysée
  applicationId String

  /// Score global Éco-index
  indice        Float
  /// Émissions de CO2 (en grammes équivalent CO2)
  ges           Float
  /// Consommation d'eau (en centilitres)
  water           Float

  /// Horodatage du calcul
  date_scan     DateTime    @default(now())

  @@index([applicationId])
}