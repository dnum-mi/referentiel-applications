model HostingOption {
  id       String    @id @default(cuid())
  room     String?
  building String?
  site     String
  platform String
  provider String
  hostings Hosting[]
}

model Hosting {
  id    String  @id @default(cuid())
  label String?

  hostingOptionId String?
  hostingOption   HostingOption? @relation(fields: [hostingOptionId], references: [id])
  applicationId   String
  application     Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  metadatas       Metadata[]     @relation("HostingMetadata")
}

enum Nature {
  NON_DEFINIE
  PHYSIQUE
  VIRTUEL
  CLOUD
  BARRE_METAL
}
