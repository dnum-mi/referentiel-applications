model Hosting {
  id              String   @id @default(cuid())
  provider String?
  label           String?
  region          String?
  site            String?
  nature          Nature?
  platform        String?
  applicationId   String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

enum Nature {
  NON_DEFINIE
  PHYSIQUE
  VIRTUEL
  CLOUD
  BARRE_METAL
}

