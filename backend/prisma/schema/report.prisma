/// Problème ou anomalie signalée pour une fiche application.
/// Suit les signalements de la création à la résolution.
///
/// @namespace Signalements
model Report {
  /// Identifiant unique
  id            String       @id @default(uuid())
  /// Identifiant de la fiche application affectée
  applicationId String?
  /// Identifiant de l'utilisateur qui a fait le signalement
  notifierId    String
  /// Utilisateur qui a fait le signalement
  notifier      User         @relation(fields: [notifierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Description du problème signalé
  description   String
  notes         String       @default("")
  /// Statut actuel du signalement
  status        ReportStatus @default(in_pending)
  /// Quand le signalement a été créé
  createdAt     DateTime     @default(now())
  /// Quand le signalement a été mis à jour pour la dernière fois
  updatedAt     DateTime     @updatedAt

  /// Historique des changements de statut et actions
  history     ReportHistory[]
  /// Application affectée par ce signalement
  application Application?    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

/// Enregistrement historique des changements d'un signalement.
/// Suit les transitions de statut et les actions prises.
///
/// @namespace Signalements
model ReportHistory {
  /// Identifiant unique
  id       String       @id @default(uuid())
  /// Identifiant du signalement associé
  reportId String
  /// Action prise
  action   String
  /// Statut après l'action
  status   ReportStatus
  /// Quand cette action s'est produite
  date     DateTime     @default(now())

  /// Le signalement auquel cette entrée d'historique appartient
  report Report @relation(fields: [reportId], references: [id])
}

/// Statut d'un signalement.
///
/// @namespace Signalements
enum ReportStatus {
  /// En attente de révision
  in_pending
  /// En cours de traitement
  in_progress
  /// Résolue
  done
}
