/// Token API pour l'accès programmatique.
/// Permet aux comptes de service ou à l'automatisation d'accéder à l'API.
///
/// @namespace Users
model Token {
  /// Identifiant unique
  id          String      @id @default(uuid())
  /// Role accordé à ce token
  role Roles? 
  /// Description de l'utilité de ce token
  description String
  /// Nom lisible pour ce token
  name        String      @db.VarChar(255)
  /// Valeur de token hachée pour l'authentification
  hash        String      @unique @db.VarChar(512)
  /// Quand ce token expire
  expiresAt   DateTime
  /// Quand ce token a été créé
  createdAt   DateTime    @default(now())
  /// Quand ce token a été mis à jour pour la dernière fois
  updatedAt   DateTime    @updatedAt
  /// Statut actuel du token
  status      TokenStatus @default(active)

  userIdImpersonate String
  /// Utilisateur que ce token usurpe
  userImpersonate   User   @relation("TokenUserImpersonate", fields: [userIdImpersonate], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdById       String
  /// Utilisateur qui a créé ce token
  createdBy         User   @relation("TokenUserCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

/// Statut d'un token API
///
/// @namespace Users
enum TokenStatus {
  /// Token actuellement valide
  active
  /// Token expiré
  expired
  /// Token révoqué
  revoked
}
