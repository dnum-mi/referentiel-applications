model Token {
  id          String      @id @default(uuid())
  adminLevel  Int?
  description String
  name        String
  hash        String      @unique
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  status      TokenStatus @default(active)

  // Relations
  userIdImpersonate String
  userImpersonate   User   @relation("TokenUserImpersonate", fields: [userIdImpersonate], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdById       String
  createdBy         User   @relation("TokenUserCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

enum TokenStatus {
  active
  expired
  revoked
}
