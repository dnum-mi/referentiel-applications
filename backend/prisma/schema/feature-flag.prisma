/// Feature flag global activable à chaud.
/// La table est la source de vérité : la bascule se fait au runtime via l'écran
/// d'admin, sans redéploiement. La synchronisation au démarrage du backend
/// (`syncFeatureFlagCatalog`) garantit que chaque flag du catalogue
/// (`FeatureFlagKey`) existe dans tous les environnements ; l'état initial est
/// fixé par le catalogue (activé pour les fonctionnalités déjà en production,
/// désactivé pour l'expérimental) et n'est jamais écrasé ensuite.
///
/// @namespace Config
model FeatureFlag {
  /// Clé technique stable (ex. "fulltext-search")
  key         String   @id @db.VarChar(100)
  /// Libellé affiché dans l'admin
  label       String   @db.VarChar(150)
  /// Description de la fonctionnalité
  description String?
  /// État courant
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  /// Dernier admin ayant basculé le flag (audit)
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  /// Historique des bascules de ce flag
  logs FeatureFlagLog[]
}

/// Journal des bascules de feature flags : une entrée par PATCH, écrite dans la
/// même transaction que la bascule (pattern `UserPermissionLog`).
///
/// @namespace Config
model FeatureFlagLog {
  id          String      @id @default(cuid())
  /// Flag concerné
  flagKey     String      @db.VarChar(100)
  flag        FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)
  /// État APRÈS la bascule
  enabled     Boolean
  /// Admin réel ayant effectué la bascule (SetNull si le compte est supprimé)
  changedById String?
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime    @default(now())

  @@index([flagKey, changedAt(sort: Desc)])
}
