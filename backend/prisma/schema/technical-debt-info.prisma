model TechnicalDebtInfo {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation("ApplicationTechnicalDebtInfo", fields: [applicationId], references: [id], onDelete: Cascade)
  metadatas     Metadata[]  @relation("TechnicalDebtInfoMetadata")

  technicalMaturity Decimal @default(0) @db.Decimal(3, 2)
  businessMaturity  Decimal @default(0) @db.Decimal(3, 2)
  costMaturity      Decimal @default(0) @db.Decimal(3, 2)
}
