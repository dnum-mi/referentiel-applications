/// Permissions accordées à un type d'acteur.
/// Définit quelles actions les acteurs de ce type peuvent effectuer.
///
/// @namespace Users
model AppPermissions {
  /// Peut lire les informations de base de l'application
  AppRead  Boolean
  /// Peut écrire les informations de base de l'application
  AppWrite Boolean

  /// Peut mettre à jour les paramètres de priorité de redémarrage
  AppWritePriority Boolean @default(false)

  /// Peut lire les informations des acteurs
  ActorRead  Boolean
  /// Peut écrire les informations des acteurs
  ActorWrite Boolean

  /// Peut lire les informations de conformité
  ComplianceRead  Boolean
  /// Peut écrire les informations de conformité
  ComplianceWrite Boolean

  /// Peut lire les informations d'hébergement
  HostingRead  Boolean
  /// Peut écrire les informations d'hébergement
  HostingWrite Boolean

  /// Peut lire les métadonnées
  MetadataRead Boolean

  /// Peut lire les données de l'application (onglet Données)
  DataRead Boolean @default(true)

  /// Peut lire les relations d'application
  RelationRead  Boolean
  /// Peut écrire les relations d'application
  RelationWrite Boolean

  /// Peut lire les liens externes
  LinkRead  Boolean
  /// Peut écrire les liens externes
  LinkWrite Boolean

  /// Peut lire les signalements
  ReportRead   Boolean @default(false)
  /// Peut créer des signalements
  ReportPost   Boolean @default(true)
  /// Peut gérer (mettre à jour/supprimer) les signalements
  ReportManage Boolean @default(false)

  actorTypeId String    @unique
  /// Type d'acteur auquel ces permissions s'appliquent
  actorType   ActorType @relation(fields: [actorTypeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

/// Permissions globale et aussi les applications permissions. 
/// Définit quelles actions sont disponible sur l'ensemble de l'application 
/// Deux types: Permissions applicatives (par app) & Permissions Globales (Crée une application, crée un signalement globale etc...) 
///
/// @namespace Permissions
enum Permission {
  // --- Permissions globales ---
  /// Capacité de créer de nouvelles applications
  CreateApplication
  /// Capacité de supprimer une application
  DeleteApplication
  /// Capacité de créer des signalements globaux
  CreateGlobalReport
  /// Voir la liste des applications sur le TIME
  MDITList
  /// Voir la liste des applications
  AppList
  /// Exporter les données
  DataExport
  /// Manager l'admin panel
  AdminPanelManage
  /// Crée un nouveau type d'acteur 
  ActorTypePost
  /// Editer un nouveau type d'acteur 
  ActorTypeManage
  /// Supprimer un nouveau type d'acteur 
  ActorTypeDelete
  /// Gérer les organizations (créer, modifier, supprimer) 
  OrganizationManage
  /// Afficher toutes les colonnes des applications
  ColumnRead

  // --- Permissions applicatives (par app) ---
  // Couple read/write classique
  AppRead // Voir les infos de base
  AppWrite // Modifier les infos de base
  ActorRead // Voir les acteurs
  ActorWrite // Modifier les acteurs
  ComplianceRead // Voir les conformites
  ComplianceWrite // Modifier les conformites
  HostingRead // Voir les hebergements
  HostingWrite // Modifier les hebergements
  RelationRead // Voir les relations
  RelationWrite // Modifier les relations
  LinkRead // Voir les liens
  LinkWrite // Modifier les liens
  // Permissions autonomes binaires (pas de couple read/write)
  AppWritePriority // Modifier la priorite de redemarrage. Lecture couverte par AppRead.
  MetadataRead // Voir l'historique des metadonnees. Pas de write : donnees generees automatiquement.
  DataRead // Voir les donnees de l'application (onglet Donnees). Pas de write pour le moment.
  // Signalements (3 niveaux)
  ReportRead // Voir les signalements
  ReportPost // Creer des signalements sur une app
  ReportManage // Gerer les signalements (implique ReportRead + ReportPost)
}
