model Application {
  id                  String                @id @default(uuid())
  label               String
  shortName           String?
  logo                String?
  description         String
  targetPopulations   String[]
  purposes            String[]
  tags                String[]
  status               Status   @default(under_construction)
  metadatas           Metadata[]            @relation("ApplicationMetadatas")
  actors              Actor[]               @relation("ApplicationActors")
  compliances         Compliance[]          @relation("ApplicationCompliances")
  anomalyNotification AnomalyNotification[] @relation("ApplicationAnomalyNotification")
  externalRessource   ExternalRessource[]   @relation("ApplicationExternalsRessource")
  hostings            Hosting[]

  ownerId String
  owner   User   @relation("UserApplications", fields: [ownerId], references: [keycloakId])

  relationsAsSource Relation[] @relation("SourceHasTarget")
  relationsAsTarget Relation[] @relation("TargetHasSource")
  labels            Label[]    @relation("ApplicationLabels")

  priorityRestart priorityRestart?
  quality             Int

  @@unique([label, description])
  @@index([label])
  @@index([shortName])
  @@map("applications")
}

view ApplicationsExport {
  id                      String            @unique
  application             String
  short                   String?           @map("short")
  description             String
  priorityRestart         priorityRestart?  @map("priorityRestart")
  hebergements            String            @map("hebergements")
  tags                    String[]
  MOA                     String            @map("MOA")
  MOE                     String            @map("MOE")
  Hebergeur               String            @map("Hebergeur")
  RSSIM                   String            @map("RSSIM")
  AutresActeurs           String            @map("Autres Acteurs")
  ConformitePDMA          String            @map("Conformité PDMA")
  ConformiteDIMA          String            @map("Conformité DIMA")
  ConformitePRA           String            @map("Conformité PRA")
  ConformiteRGAA          String            @map("Conformité RGAA")
  ConformiteDSFR          String            @map("Conformité DSFR")
  ConformiteAIPD          String            @map("Conformité AIPD")
  AutresConformites       String            @map("Autres Conformités")
  liens                   String            @map("liens")

  @@map("export_full_detailed")
}

model Relation {
  id                String       @id @default(uuid())
  type              RelationType
  applicationSourceId String @map("applicationSource")
  applicationTargetId String @map("applicationTarget")
  sourceApplication Application  @relation("SourceHasTarget", fields: [applicationSourceId], references: [id], onDelete: Cascade)
  targetApplication Application  @relation("TargetHasSource", fields: [applicationTargetId], references: [id], onDelete: Cascade)

  @@unique([applicationSourceId, applicationTargetId, type])
  @@map("relations")
}

enum RelationType {
  is_part_of
  in_replacement_of
  is_service_user_of
  is_data_user_of
}

enum priorityRestart {
  R0
  R1
  R1_STAR
  R2
  R3
}

enum Status {
  under_construction
  in_production_mvp
  in_production
  in_production_decommissioning
  decommissioned
  deleted
}