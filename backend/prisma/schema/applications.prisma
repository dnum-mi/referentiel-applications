model Application {
  id                  String                @id @default(uuid())
  label               String
  shortName           String?
  logo                String?
  description         String
  targetPopulations   String[]
  purposes            String[]
  tags                String[]
  metadataId          String
  metadata            Metadata              @relation("ApplicationMetadata", fields: [metadataId], references: [id])
  actors              Actor[]               @relation("ApplicationActors")
  compliances         Compliance[]          @relation("ApplicationCompliances")
  anomalyNotification AnomalyNotification[] @relation("ApplicationAnomalyNotification")
  externalRessource   ExternalRessource[]   @relation("ApplicationExternalsRessource")
  events              Event[]               @relation("ApplicationEvents")
  hostings            Hosting[]

  ownerId String
  owner   User   @relation("UserApplications", fields: [ownerId], references: [keycloakId])

  relationsAsSource Relation[] @relation("SourceHasTarget")
  relationsAsTarget Relation[] @relation("TargetHasSource")
  labels            Label[]    @relation("ApplicationLabels")

  priorityRestart priorityRestart?

  @@unique([label, description])
  @@index([label])
  @@index([shortName])
  @@map("applications")
}

model Relation {
  id                String       @id @default(uuid())
  type              RelationType
  applicationSource String
  applicationTarget String
  sourceApplication Application  @relation("SourceHasTarget", fields: [applicationSource], references: [id], onDelete: Cascade)
  targetApplication Application  @relation("TargetHasSource", fields: [applicationTarget], references: [id], onDelete: Cascade)

  @@unique([applicationSource, applicationTarget, type])
  @@map("relations")
}

enum RelationType {
  is_part_of
  in_replacement_of
  is_service_user_of
  is_data_user_of
}

enum priorityRestart {
  R0
  R1
  R1_STAR
  R2
  R3
}
