model Application {
  id                  String                @id @default(uuid())
  label               String
  shortName           String?
  logo                String?
  description         String
  targetPopulations   String[]
  purposes            String[]
  currentStatusId     String?
  currentStatus       ApplicationStatus?    @relation(fields: [currentStatusId], references: [id], onDelete: SetNull)
  metadatas           Metadata[]            @relation("ApplicationMetadatas")
  actors              Actor[]               @relation("ApplicationActors")
  compliance          Compliance?           @relation("ApplicationCompliance")
  anomalyNotification AnomalyNotification[] @relation("ApplicationAnomalyNotification")
  externalRessource   ExternalRessource[]   @relation("ApplicationExternalsRessource")
  hostings            Hosting[]
  statuses            ApplicationStatus[]   @relation("ApplicationStatuses")

  relationsAsSource Relation[] @relation("SourceHasTarget")
  relationsAsTarget Relation[] @relation("TargetHasSource")
  labels            Label[]    @relation("ApplicationLabels")
  tags              Tag[]

  priorityRestart priorityRestart?
  quality         Int

  @@unique([label, description])
  @@index([label])
  @@index([shortName])
  @@index([currentStatusId])
}

model ApplicationStatus {
  id            String        @id @default(uuid())
  applicationId String
  application   Application   @relation("ApplicationStatuses", fields: [applicationId], references: [id], onDelete: Cascade)
  status        Status
  statusDate    DateTime?
  createdAt     DateTime      @default(now())
  Application   Application[]

  @@index([applicationId])
  @@index([statusDate])
  @@index([createdAt])
}

model Relation {
  id                  String       @id @default(uuid())
  type                RelationType
  applicationSourceId String
  applicationTargetId String
  sourceApplication   Application  @relation("SourceHasTarget", fields: [applicationSourceId], references: [id], onDelete: Cascade)
  targetApplication   Application  @relation("TargetHasSource", fields: [applicationTargetId], references: [id], onDelete: Cascade)

  @@unique([applicationSourceId, applicationTargetId, type])
}

enum RelationType {
  is_part_of
  in_replacement_of
  is_service_user_of
  is_data_user_of
}

enum priorityRestart {
  R0
  R1
  R1_STAR
  R2
  R3
}

enum Status {
  under_construction
  poc
  in_production_mvp
  in_production
  in_production_decommissioning
  decommissioned
  deleted
}
