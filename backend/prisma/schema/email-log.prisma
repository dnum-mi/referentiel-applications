/// Historique des e-mails effectivement envoyés par le système, consultable par les administrateurs.
model EmailLog {
  /// Identifiant unique
  id      String   @id @default(cuid())
  /// Destinataire(s) de l'e-mail
  to      String
  /// Objet de l'e-mail
  subject String
  /// Contenu HTML complet de l'e-mail envoyé
  html    String
  /// Contenu texte de l'e-mail envoyé
  text    String
  /// Date et heure d'envoi
  sentAt  DateTime @default(now())
  /// Faux si généré alors que les envois SMTP étaient désactivés : le contenu reste consultable
  /// (notification in-app, historique admin) mais aucun e-mail réel n'est parti (#2411).
  wasSent Boolean  @default(true)
  /// Notifications in-app pointant vers cet e-mail (#2280 — suite)
  notifications Notification[]

  @@index([sentAt])
}
