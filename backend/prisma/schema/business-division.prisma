/// Direction metier MOA
///
/// @namespace BusinessDivision
model BusinessDivision {
  /// Identifiant unique
  id            String        @id @default(uuid())
  /// Label de la direction metier MOA
  label         String   @unique     @db.VarChar(255)
  /// Applications associées à cette direction metier
  applications  Application[]
  /// Organisations associées à cette direction metier
  organizations Organization[]
}
