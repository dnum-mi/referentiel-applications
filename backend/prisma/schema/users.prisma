model User {
  id                  String                @id @default(uuid())
  keycloakId          String?               @unique
  email               String                @unique
  lastLogin           DateTime?             @default(now())
  organizationId      String?
  organization        Organization?         @relation(fields: [organizationId], references: [id])
  createdSet          Metadata[]            @relation("MetadataCreatedBy")
  dataOwners          Metadata[]            @relation("MetadataDataOwnerBy")
  AnomalyNotification AnomalyNotification[] @relation("UserAnomalyNotification")
  adminLevel          Int                   @default(0)
  tokensImpersonate   Token[]               @relation("TokenUserImpersonate")
  tokensCreated       Token[]               @relation("TokenUserCreator")
  type                UserType              @default(human)
  capabilities        CapabilityNames[]
  followedApplications Application[] @relation("UserFollowedApplications")
  emailNotificationsEnabled Boolean         @default(true)
}

model Actor {
  id             String        @id @default(uuid())
  firstname      String?
  lastname       String?
  email          String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  applicationId  String?
  application    Application?  @relation("ApplicationActors", fields: [applicationId], references: [id], onDelete: Cascade)
  actorTypeId    String?
  actorType      ActorType?    @relation(fields: [actorTypeId], references: [id])
  metadatas      Metadata[]    @relation("ActorMetadata")
  compliances    Compliance[]  @relation("ComplianceHomologationRSSI")

  @@index([applicationId, actorTypeId])
}

model ActorType {
  id          String  @id @default(uuid())
  code        String?
  label       String
  description String?

  actors         Actor[]
  appPermissions AppPermissions[]

  @@unique([code])
}

enum UserType {
  human
  bot
}

enum CapabilityNames {
  CreateApplication
  CreateGlobalAnomalyNotification
}
