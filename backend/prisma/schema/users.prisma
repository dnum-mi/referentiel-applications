/// Compte utilisateur dans le référentiel des applications.
/// Peut être soit un utilisateur humain soit un compte de service.
///
/// @namespace Users
model User {
  /// Identifiant unique
  id                        String              @id @default(uuid())
  /// Adresse email de l'utilisateur
  email                     String              @unique @db.VarChar(255)
  /// Id de l'organisation à laquelle l'utilisateur appartient
  organizationId            String?
  /// Organisation à laquelle l'utilisateur appartient
  organization              Organization?       @relation("UserOrganization", fields: [organizationId], references: [id])

  /// Id de l'organisation de scope de l'utilisateur (pour les permissions basées sur le scope organisationnel) 
  scopeOrganizationId            String?
  /// Organisation de scope de l'utilisateur
  scopeOrganization              Organization?       @relation("UserScopeOrganization", fields: [scopeOrganizationId], references: [id])

  /// Entrées de métadonnées créées par cet utilisateur
  createdSet                Metadata[]          @relation("MetadataCreatedBy")
  /// Entrées de métadonnées où cet utilisateur est le propriétaire des données
  dataOwners                Metadata[]          @relation("MetadataDataOwnerBy")
  /// Signalements créés par cet utilisateur
  reports                   Report[]
  /// Groupement de permissions par defaut
  role                      Roles               @default(VISITOR)
  /// Tokens API qui se font passer pour cet utilisateur
  tokensImpersonate         Token[]             @relation("TokenUserImpersonate")
  /// Tokens API créés par cet utilisateur
  tokensCreated             Token[]             @relation("TokenUserCreator")
  /// Type de compte utilisateur (humain ou bot)
  type                      UserType            @default(human)
  /// Applications suivies par cet utilisateur pour les notifications
  followedApplications      Application[]       @relation("UserFollowedApplications")
  /// Applications consultées par cet utilisateur
  applicationViews          ApplicationView[]
  /// Si les notifications par email sont activées
  emailNotificationsEnabled Boolean             @default(true)
  /// Permissions supplémentaire (ancien capabilities) 
  additionalPermissions     Permission[]
  userPermissionLog         UserPermissionLog[]
  userConnexionLog          UserConnexionLog[]
  /// Sessions d'impersonation initiées par cet utilisateur (en tant qu'admin)
  impersonationsAsAdmin     ImpersonationLog[]  @relation("ImpersonationAdmin")
  /// Sessions où cet utilisateur a été impersonné
  impersonationsAsTarget    ImpersonationLog[]  @relation("ImpersonationTarget")
  /// Feature flags basculés par cet utilisateur (audit)
  featureFlagsUpdated       FeatureFlag[]
}

/// @namespace Roles
enum Roles {
  VISITOR
  READER
  CONTRIBUTOR
  ADMIN
}

/// Personne ou entité impliquée avec une application.
/// Peut avoir différents rôles définis par ActorType.
///
/// @namespace Users
model Actor {
  /// Identifiant unique
  id             String        @id @default(uuid())
  /// Prénom de l'acteur
  firstname      String?       @db.VarChar(100)
  /// Nom de l'acteur
  lastname       String?       @db.VarChar(100)
  /// Email de contact
  email          String?       @db.VarChar(255)
  /// id de l'organisation
  organizationId String?
  /// Organisation à laquelle cet acteur appartient
  organization   Organization? @relation(fields: [organizationId], references: [id])
  /// id de l'application dont l'utilisateur est acteur
  applicationId  String?
  /// Application à laquelle cet acteur est associé
  application    Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// id du type de cet acteur
  actorTypeId    String?
  /// Rôle/type de cet acteur
  actorType      ActorType?    @relation(fields: [actorTypeId], references: [id])
  /// Entrées de métadonnées pour cet acteur
  metadatas      Metadata[]
  /// Enregistrements de conformité
  compliances    Compliance[]
  /// Indique si l'acteur est un groupe ou une personne physique
  isGroup         Boolean       @default(false)

  @@index([applicationId, actorTypeId])
}

/// Définit les différents rôles que les acteurs peuvent avoir.
/// ### Codes des acteurs possibles
/// | Code | Rôle / Description |
/// | :--- | :--- |
/// | **MOA** | Maîtrise d’Ouvrage (MOA) |
/// | **MOE** | Maîtrise d’Œuvre (MOE) |
/// | **RSSI** | Responsable de la Sécurité des Systèmes d’Information (RSSI) |
/// | **ArchitecteApplicatif** | Architecte applicatif |
/// | **ArchitecteTechnique** | Architecte technique |
/// | **TMA** | Tierce Maintenance Applicative (TMA) |
/// | **Exploitation** | Responsable d'exploitation opérationnel |
/// | **RSIMM** | Responsables des SI Métier et de la Modernisation (RSIMM) |
/// | **CPD** | Correspondant à la protection des données (CPD) |
/// | **OrganismeBeneficiaire** | Correspondant Stratégique Métier (CSM) |
/// | **ProductOwner** | Product Owner (PO) |
/// | **ProductManager** | Product Manager (PM) |
/// | **Hebergement** | Responsable de l'hébergement |
/// | **Autre** | Autre |
/// @namespace Users
model ActorType {
  /// Identifiant unique
  id          String  @id @default(uuid())
  /// Code court pour le rôle
  code        String? @db.VarChar(50)
  /// Nom d'affichage du rôle
  label       String  @db.VarChar(255)
  /// Description des responsabilités de ce rôle
  description String?
  /// Type d'acteur « administrateur de l'application » : ses acteurs disposent
  /// toujours de l'ensemble des droits (lecture + écriture) sur l'application
  /// concernée, indépendamment de la matrice AppPermissions éditable.
  isAdmin     Boolean @default(false)

  /// Acteurs avec ce type
  actors         Actor[]
  /// Permissions associées à ce type d'acteur
  appPermissions AppPermissions[]

  @@unique([code])
}

/// Type de compte utilisateur
///
/// @namespace Users
enum UserType {
  /// Utilisateur humain régulier
  human
  /// Bot automatisé ou compte de service
  bot
}

/// Capacités spéciales pouvant être accordées aux utilisateurs
///
/// @namespace Users
enum CapabilityNames {
  /// Capacité de créer de nouvelles applications
  CreateApplication
  /// Capacité de créer des signalements globaux
  CreateGlobalReport
}
