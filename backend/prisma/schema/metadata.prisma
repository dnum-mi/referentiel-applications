model Metadata {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  description String?

  action      MetadataAction @default(add)

  applicationId String
  application   Application @relation("ApplicationMetadatas", fields: [applicationId], references: [id])

  createdById String
  createdBy   User @relation("MetadataCreatedBy", fields: [createdById], references: [keycloakId])

  dataOwnerId String?
  dataOwner   User? @relation("MetadataDataOwnerBy", fields: [dataOwnerId], references: [keycloakId])

  eventId     String? 
  event       Event? @relation("EventMetadata", fields: [eventId], references: [id])

  complianceId String?
  compliance   Compliance? @relation("ComplianceMetadata", fields: [complianceId], references: [id])

  labelId     String?
  label       Label? @relation("LabelMetadata", fields: [labelId], references: [id])

  actorId     String?
  actor       Actor? @relation("ActorMetadata", fields: [actorId], references: [id])

  externalRessourceId String?
  externalRessource   ExternalRessource? @relation("ExternalRessourceMetadata", fields: [externalRessourceId], references: [id])

  hostingId String?
  hosting   Hosting? @relation("HostingMetadata", fields: [hostingId], references: [id])

  @@map("metadata")
}

enum MetadataAction {
  add
  update
  delete
}
