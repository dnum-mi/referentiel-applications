/// sources qui fournissent des libellés alternatifs.
/// Les sources sont globales et peuvent être partagées entre libellés alternatifs.
/// 
/// @namespace Labels 
model LabelSource {
  /// Identifiant unique 
  id     String  @id @default(uuid())
  /// Nom unique du système source 
  source String  @unique @db.VarChar(255)
  Label  Label[]
}

/// Label/étiquette attaché à une application.
/// 
/// @namespace Applications 
model Label {
  /// Identifiant unique 
  id            String       @id @default(uuid())
  /// Valeur du label 
  value         String       @db.VarChar(255)
  labelSourceId String?
  /// Système source qui a fourni ce label 
  labelSource   LabelSource? @relation(fields: [labelSourceId], references: [id], onDelete: Cascade)
  /// Entrées de métadonnées pour ce label 
  metadatas     Metadata[]
  applicationId String
  /// Application à laquelle ce label appartient 
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  // Index trigramme pour les filtres « contient » sur les libellés alternatifs
  // (paramètres de recherche `search` et `label`).
  @@index([value(ops: raw("gin_trgm_ops"))], map: "Label_value_trgm_idx", type: Gin)
}
