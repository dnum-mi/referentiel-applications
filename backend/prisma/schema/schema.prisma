generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres", "driverAdapters", "prismaSchemaFolder", "views"]
  binaryTargets   = ["native"]
}

generator markdown {
  provider = "prisma-markdown"
  output   = "../docs/schema.md"
  title    = "Documentation Référentiel des Applications"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
